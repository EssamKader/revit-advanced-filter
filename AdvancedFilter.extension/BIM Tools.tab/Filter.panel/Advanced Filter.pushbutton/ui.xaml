<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Filter" Width="460" Height="620" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Category / Family / Type" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TreeView Grid.Row="1" x:Name="tree" Background="#252526" Foreground="#E6E6E6"
                  BorderBrush="#3F3F46" Padding="4"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="isolate_button" Content="Isolate" IsDefault="True"
                    Background="#0E639C" BorderBrush="#0E639C" Click="isolate_click"/>
            <Button x:Name="cancel_button" Content="Cancel" IsCancel="True" Click="cancel_click"/>
        </StackPanel>
    </Grid>
</Window>
