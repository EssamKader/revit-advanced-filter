<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Filter" Width="640" Height="620" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Category / Family / Type" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Levels" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox Grid.Row="1" x:Name="all_levels" Content="All levels" IsChecked="True" Margin="4,0,0,6"/>
                <ListBox Grid.Row="2" x:Name="level_list" Background="#252526" Foreground="#E6E6E6"
                         BorderBrush="#3F3F46" Padding="2"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="search_box" Background="#252526" Foreground="#E6E6E6"
                             CaretBrush="#E6E6E6" BorderBrush="#3F3F46" Padding="6,4"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="0" x:Name="search_hint" Text="Search category, family or type&#8230;"
                               Foreground="#808080" Margin="9,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Button Grid.Column="1" x:Name="search_clear" Content="&#10005;" Click="search_clear_click"
                            MinWidth="26" Padding="6,4" Margin="4,0,0,0" ToolTip="Clear search"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="select_all_button" Content="Select all" Click="select_all_click"
                            Padding="10,3" Margin="0,0,6,0" MinWidth="0"/>
                    <Button x:Name="clear_button" Content="Clear" Click="clear_click"
                            Padding="10,3" Margin="0,0,6,0" MinWidth="0"/>
                    <Button x:Name="expand_all_button" Content="Expand all" Click="expand_all_click"
                            Padding="10,3" Margin="0,0,6,0" MinWidth="0"/>
                    <Button x:Name="collapse_all_button" Content="Collapse all" Click="collapse_all_click"
                            Padding="10,3" Margin="0" MinWidth="0"/>
                </StackPanel>
                <TreeView Grid.Row="2" x:Name="tree" Background="#252526" Foreground="#E6E6E6"
                          BorderBrush="#3F3F46" Padding="4"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="status_text" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="isolate_button" Content="Isolate" IsDefault="True"
                        Background="#0E639C" BorderBrush="#0E639C" Click="isolate_click"/>
                <Button x:Name="cancel_button" Content="Cancel" IsCancel="True" Click="cancel_click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
